# Скопируй в deploy/.env (chmod 600) и заполни. В git этот файл не попадает.

# Домен сайта без https:// и без www
DOMAIN=111cult.ru

# Длинная случайная строка. Сгенерировать: openssl rand -base64 48
DJANGO_SECRET_KEY=

# База данных. Пароль придумай сам (openssl rand -base64 24), потом его не меняй:
# Postgres запоминает пароль при первом запуске
POSTGRES_DB=prodclub
POSTGRES_USER=prodclub
POSTGRES_PASSWORD=

# Пусто = магазин, вход и корзина скрыты. Значение 1 включает магазин.
# Вшивается в сборку: после изменения нужна пересборка (deploy/update.sh).
NEXT_PUBLIC_SHOP_ENABLED=
